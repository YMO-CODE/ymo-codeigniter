# Copy this file to .env and adjust for each environment.
# These values are read via getenv(); load them through your web server
# (e.g. SetEnv in Apache, fastcgi_param in nginx) or via a process manager.

# Application — dual hostname (booking + optional admin subdomain)
# YMO_PUBLIC_APP_URL is canonical for booking/customer links and CLI-built URLs.
# YMO_ADMIN_APP_URL enables the admin subdomain; leave unset locally to keep /admin paths.
CI_ENV=development
YMO_APP_URL=https://booking.yourmechaniconline.com
YMO_PUBLIC_APP_URL=https://booking.yourmechaniconline.com
YMO_ADMIN_APP_URL=https://admin.yourmechaniconline.com
# Marketing site (www) — same CodeIgniter app, separate hostname routes
YMO_MARKETING_APP_URL=https://www.yourmechaniconline.com
# Set to 1 only when TLS/host termination is on a trusted reverse proxy that sends
# X-Forwarded-Host — never expose Apache directly on a public IP with this enabled.
YMO_TRUST_PROXY_HEADERS=
YMO_COOKIE_DOMAIN=.yourmechaniconline.com
YMO_ENCRYPTION_KEY=replace-with-32-byte-random-string

# LiveChat widget (customer site). Set to 0 to disable.
YMO_LIVECHAT_LICENSE=19881722

# Optional: separate root password for MySQL container (production)
# YMO_DB_ROOT_PASS=
YMO_DB_HOST=localhost
YMO_DB_NAME=ymo_booking
YMO_DB_USER=ymo_user
YMO_DB_PASS=change-me

# Email (PHPMailer / SMTP)
YMO_MAIL_HOST=smtp.gmail.com
YMO_MAIL_PORT=587
YMO_MAIL_USER=no-reply@yourmechaniconline.com
YMO_MAIL_PASS=app-password
YMO_MAIL_ENC=tls
YMO_MAIL_FROM=no-reply@yourmechaniconline.com
YMO_MAIL_FROM_NAME=Your Mechanic Online

# Notifications
YMO_SUPPORT_EMAIL=contactus@yourmechaniconline.com
YMO_ADMIN_NOTIFY=admin@yourmechaniconline.com

# SMS gateway (MSG91 — DLT-registered templates required in India)
YMO_SMS_DRIVER=msg91
YMO_MSG91_AUTHKEY=
YMO_MSG91_SENDER=YMOCAR
YMO_MSG91_ROUTE=4
YMO_TPL_OTP=
YMO_TPL_BOOKING_OK=
YMO_TPL_BOOKING_STATUS=
YMO_TPL_SERVICE_REMIND=
YMO_TPL_REVIEW=

# Service invoice SMS (DLT) — vars: ref, total
YMO_TPL_INVOICE=

# Referral programme — vars: name, amount, ref
YMO_TPL_REFERRAL=
YMO_REFERRAL_ENABLED=1
YMO_REFERRAL_CREDIT_REFERRER=500
YMO_REFERRAL_CREDIT_REFERRED=300

# CRM integrations — lead capture webhooks
# See CRM_SETUP.md §7 (Meta/Instagram), §7b (Instagram DMs), §9 (WhatsApp)
#
# CRM_WEBHOOK_SECRET=random-string-for-hmac-sha256-on-website-and-whatsapp-webhooks
# CRM_META_VERIFY_TOKEN=random-string-must-match-meta-app-webhook-verify
# CRM_META_ACCESS_TOKEN=page-token-with-leads_retrieval-and-messaging-permissions
# CRM_WHATSAPP_PHONE_NUMBER_ID=from Meta WhatsApp Business setup (required for outbound WhatsApp)
# CRM_META_PAGE_ID=Facebook Page ID linked to Instagram (optional reference)
CRM_WEBHOOK_SECRET=
CRM_META_VERIFY_TOKEN=
CRM_META_ACCESS_TOKEN=
CRM_WHATSAPP_PHONE_NUMBER_ID=
CRM_META_PAGE_ID=
# CRM campaign — single variable (default API key: var1)
YMO_TPL_CRM_CAMPAIGN=

# Google Search Console API (automated SEO fetch — see deploy/marketing/GSC_SETUP.md)
# YMO_GSC_PROPERTY=https://www.yourmechaniconline.com/
# YMO_GSC_CREDENTIALS=deploy/marketing/gsc-credentials.json
# YMO_GSC_DAYS=487

# Google Business Profile — Place ID for review email links (optional)
# YMO_GBP_PLACE_ID=ChIJ...

# MSG91 API variable names (must match ##placeholders## in each MSG91 template).
# Defaults: otp=otp, others=var1,var2. Override if you renamed variables in MSG91:
# YMO_MSG91_VARKEYS_BOOKING_STATUS=ref,status
# YMO_MSG91_VARKEYS_BOOKING_CONFIRMED=name,ref
